  "info": {
    "description": "Orbital element sets and satellite metadata from CelesTrak.",
    "title": "Satellite Tracker API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/elements": {
      "get": {
        "description": "Clients propagate these with SGP4. Supports ETag / If-None-Match.",
        "operationId": "group_elements_api_v1_elements_get",
        "parameters": [
          {
            "in": "query",
            "name": "group",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9-]{1,50}$",
              "title": "Group",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 5000,
              "maximum": 20000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ElementSetOut"
                  },
                  "title": "Response Group Elements Api V1 Elements Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified"
          },
          "404": {
            "description": "Unknown group"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Latest element sets for every satellite in a group",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/groups": {
      "get": {
        "operationId": "list_groups_api_v1_groups_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GroupOut"
                  },
                  "title": "Response List Groups Api V1 Groups Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List satellite groups",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Database unreachable"
          }
        },
        "summary": "Service health and data freshness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/satellites": {
      "get": {
        "operationId": "search_satellites_api_v1_satellites_get",
        "parameters": [
          {
            "description": "Name fragment or NORAD ID",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Name fragment or NORAD ID",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "group",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[a-z0-9-]{1,50}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Group"
            }
          },
          {
            "in": "query",
            "name": "orbit_class",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/OrbitClass"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Orbit Class"
            }
          },
          {
            "description": "CelesTrak owner code",
            "in": "query",
            "name": "country",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Z0-9/]{1,10}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CelesTrak owner code",
              "title": "Country"
            }
          },
          {
            "in": "query",
            "name": "launch_year",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 1957,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Launch Year"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 100000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SatellitePageOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search and filter satellites",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/satellites/{norad_id}": {
      "get": {
        "operationId": "get_satellite_api_v1_satellites__norad_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "norad_id",
            "required": true,
            "schema": {
              "maximum": 999999999,
              "minimum": 1,
              "title": "Norad Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SatelliteDetailOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown NORAD ID"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Satellite metadata and latest element set",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/satellites/{norad_id}/about": {
      "get": {
        "description": "Content from Wikidata (CC0), English Wikipedia (CC BY-SA 4.0) and Wikimedia Commons (per-file licenses). Show the attribution fields with the content.",
        "operationId": "get_about_api_v1_satellites__norad_id__about_get",
        "parameters": [
          {
            "in": "path",
            "name": "norad_id",
            "required": true,
            "schema": {
              "maximum": 999999999,
              "minimum": 1,
              "title": "Norad Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AboutOut"
                }
