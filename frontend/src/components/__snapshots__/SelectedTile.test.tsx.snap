exports[`SelectedTile > renders the layout without a description unchanged 1`] = `"<section class="tile" aria-labelledby="selected-heading"><header class="tile-header"><h2 id="selected-heading" class="tile-title">Selected</h2><div class="tile-meta"><span>LEO</span><button type="button" class="icon-button" aria-label="Close selected satellite"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8"></path></svg></button></div></header><div class="tile-body"><div class="tile-scroll"><h3 class="selected-name">TESTSAT 1</h3><p class="selected-sub">NORAD <span class="ident">90001</span>, United States, PAYLOAD</p><div class="hero"><div><div class="hero-value accent">—</div><div class="hero-label">altitude, km</div></div><div><div class="hero-value">—</div><div class="hero-label">speed, km/s</div></div></div><dl class="facts"><div><dt>Latitude</dt><dd class="ident">—</dd></div><div><dt>Longitude</dt><dd class="ident">—</dd></div><div><dt>Inclination</dt><dd>51.60°</dd></div><div><dt>Period</dt><dd>92.9 min</dd></div><div><dt>Launched</dt><dd>15 Jan 2020</dd></div><div><dt>Elements</dt><dd><span class="freshness" data-level="fresh"><span class="dot" aria-hidden="true"></span>2 h old</span></dd></div></dl><details class="more"><summary>More details</summary><dl class="facts"><div><dt>International designator</dt><dd class="ident">2020-001A</dd></div><div><dt>Object type</dt><dd>PAYLOAD</dd></div><div><dt>Orbit class</dt><dd>LEO</dd></div><div><dt>Element epoch</dt><dd>1 Nov 2026, 10:00:00 UTC</dd></div></dl></details></div></div></section>"`;
