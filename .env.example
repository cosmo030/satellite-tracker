# Copy to .env and adjust. The Makefile and docker compose load .env automatically.
# Full reference: docs/configuration.md

# --- Database ---------------------------------------------------------------------------------

# Password of the "sattrack" PostgreSQL user created by docker compose (required, secret).
POSTGRES_PASSWORD=<CHOOSE_A_LOCAL_PASSWORD>

# Database used by the API, the ingest worker and migrations when run on your machine
# (required). docker compose sets its own value for the containers.
SATTRACK_DATABASE_URL=postgresql+psycopg://sattrack:<CHOOSE_A_LOCAL_PASSWORD>@localhost:5432/sattrack

# Disposable database for integration tests; its tables are emptied by the tests
# (optional; integration tests are skipped when unset).
SATTRACK_TEST_DATABASE_URL=postgresql+psycopg://sattrack:<CHOOSE_A_LOCAL_PASSWORD>@localhost:5432/sattrack_test

# --- Backend ----------------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING or ERROR (optional, default: INFO).
SATTRACK_LOG_LEVEL=INFO

# CelesTrak groups to ingest, comma-separated (optional, default below).
SATTRACK_INGEST_GROUPS=stations,visual,gps-ops,galileo,weather,science

# Timeout for each request to CelesTrak, in seconds (optional, default: 30).
SATTRACK_HTTP_TIMEOUT_SECONDS=30

# Base URL of CelesTrak; must be https (optional, default: https://celestrak.org).
SATTRACK_CELESTRAK_BASE_URL=https://celestrak.org

# Browser origins allowed to call the API directly, comma-separated (optional, default: none).
# Not needed when the frontend and API share an origin, as in the default setup.
SATTRACK_CORS_ALLOWED_ORIGINS=

# --- Frontend ---------------------------------------------------------------------------------

# Where `npm run dev` forwards /api requests (optional, default: http://localhost:8000).
SATTRACK_API_PROXY_TARGET=http://localhost:8000

# Address Caddy serves the app on in docker compose (optional, default: :8080 over HTTP).
# Set to your domain name in production, e.g. tracker.example.com, to get automatic HTTPS.
SITE_ADDRESS=:8080
